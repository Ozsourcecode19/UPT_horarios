# Entorno del frontend PARA la app de escritorio (Tauri) — Fase 4 desktop.
# Se activa con `vite build --mode desktop` / `vite --mode desktop`
# (scripts build:desktop y dev:desktop de frontend/package.json).
#
# - La app de escritorio no usa el proxy de vite: habla directo al sidecar
#   en 127.0.0.1:17891 (puerto fijo; ver desktop/src-tauri/src/main.rs).
# - No es un secreto: el backend corre en la misma máquina del usuario.
VITE_ENTORNO=desktop
VITE_API_BASE_URL=http://127.0.0.1:17891/api
